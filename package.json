{
  "name": "lean-mean-vps",
  "version": "1.0.0",
  "description": "Ultra-schlanke Full-Stack App für Low-Resource VPS (512MB RAM)",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build:frontend": "bunx --bun vite build --mode client && bunx --bun vite build",
    "build:backend": "bun build ./app/api-server.ts --compile --minify --target bun --outfile lean-server",
    "build": "bun run build:frontend && bun run build:backend",
    "start": "./lean-server",
    "start:dev": "bun run ./app/api-server.ts",
    "db:push": "bunx drizzle-kit push",
    "db:generate": "bunx drizzle-kit generate",
    "db:studio": "bunx drizzle-kit studio",
    "lint": "bunx @biomejs/biome lint ./app",
    "format": "bunx @biomejs/biome format ./app --write",
    "check": "bunx @biomejs/biome check --write ./app",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@hono/vite-build": "^1.9.2",
    "@hono/vite-ssg": "^0.3.3",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.8",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@tailwindcss/vite": "^4.1.18",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.5",
    "honox": "^0.1.53",
    "tailwindcss": "^4.1.18",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "trustedDependencies": []
}
