# ============================================================================
# LEAN MEAN VPS - Environment Configuration
# ============================================================================

# Server Details
PORT=3000

# Database
# Standardmäßig 'data/sqlite.db' für lokale Entwicklung
DATABASE_URL=data/sqlite.db

# Security
# Ein geheimer Schlüssel für signierte Cookies oder andere künftige Features.
# Generiere einen mit: openssl rand -base64 32
APP_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS

# Environment
NODE_ENV=development
