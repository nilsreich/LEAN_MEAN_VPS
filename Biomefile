{
  "name": ".",
    "$schema": "[https://biomejs.dev/schemas/1.9.4/schema.json](https://biomejs.dev/schemas/1.9.4/schema.json)",
    "vcs": {
      "enabled": true,
      "clientKind": "git",
      "useIgnoreFile": true
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "lineWidth": 100
    },
    "linter": {
      "enabled": true,
      "rules": {
        "recommended": true
      }
    },
    "javascript": {
      "formatter": {
        "quoteStyle": "single",
        "jsxQuoteStyle": "double",
        "trailingCommas": "all"
      }
    }
  }